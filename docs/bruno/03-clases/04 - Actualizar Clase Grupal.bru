meta {
  name: 04 - Actualizar Clase Grupal
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/clases/{{idClase}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGerente}}
}

body:json {
  {
    "idSede": 1,
    "nombreActividad": "Spinning Avanzado",
    "fechaHoraInicio": "{{fechaInicio}}",
    "duracionMinutos": 45,
    "cupoMaximo": 1
  }
}

script:pre-request {
  const inicio = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString().slice(0, 19);
  bru.setVar("fechaInicio", inicio);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
