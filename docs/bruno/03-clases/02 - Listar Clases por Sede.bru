meta {
  name: 02 - Listar Clases por Sede
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/clases?idSede=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSocio}}
}

script:post-response {
  const yoga = res.getBody().find((c) => c.nombreActividad === "Yoga Integral (Completa)");
  bru.setVar("idClaseCompleta", yoga.idClase);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("incluye el estado del socio", function () {
    const clase = res.getBody().find((c) => c.idClase === bru.getVar("idClase"));
    expect(clase.yaReservada).to.equal(false);
    expect(clase.posicionEspera).to.equal(undefined);
  });
}
