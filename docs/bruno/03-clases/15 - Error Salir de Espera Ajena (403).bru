meta {
  name: 15 - Error Salir de Espera Ajena (403)
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/v1/lista-espera/{{idEspera}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOtroSocio}}
}

tests {
  test("responde 403", function () {
    expect(res.getStatus()).to.equal(403);
  });

  test("usa el formato común de error", function () {
    expect(res.getBody().codigo).to.equal("ACCESO_DENEGADO");
  });
}
