meta {
  name: 18 - Cancelar Reserva de Clase
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/v1/reservas-clase/{{idReserva}}/cancelar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSocio}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("queda cancelada", function () {
    expect(res.getBody().estado).to.equal("CANCELADA");
  });
}
