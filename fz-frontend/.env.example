# URL de la API del Backend (en local apunta a Spring Boot local o Render)
VITE_API_BASE_URL=http://localhost:8080/api

# Flag de datos mock: "true" = activa el modo mock centralizado (sin backend), "false" = conecta con la API real
# Centralizado en src/config.ts (USE_MOCK). Solo "true" activa los mocks.
VITE_USE_MOCK=true
