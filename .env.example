# Variables de entorno de FitZone Sports, sin valores reales.
# Copiar a .env (ignorado por git) en la raíz: docker compose lo lee solo.
#   cp .env.example .env
# Todas son opcionales para levantar el sistema; sin SUPABASE_SERVICE_ROLE_KEY no se puede iniciar sesión.

# --- Backend: autenticación (Supabase Auth) ---
# Clave de servicio del proyecto Supabase. Secreta: nunca en el código ni en variables VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
# URL del proyecto Supabase (por defecto, fitzone-db-dev)
# SUPABASE_URL=https://<proyecto>.supabase.co

# --- Backend: firmas y claves ---
# Secreto para firmar los QR de acceso (mínimo 32 caracteres). Cambiarlo fuera de local.
QR_SECRET=
# Clave para los endpoints de administración (/admin/database). En local tiene un valor por defecto.
# ROOT_API_KEY=

# --- Backend: solo despliegue (Render / perfil prod) ---
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<base>
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# CORS_ALLOWED_ORIGINS=https://<front>.vercel.app

# --- Frontend: ver fz-frontend/.env.example (VITE_API_BASE_URL, VITE_USE_MOCK) ---
